[Desktop Entry]
X-SnapInstanceName=drawio
Name=drawio
Comment=draw.io desktop
Exec=env BAMF_DESKTOP_FILE_HINT=/var/lib/snapd/desktop/applications/drawio_drawio.desktop /snap/bin/drawio %U
Terminal=false
Type=Application
Icon=/snap/drawio/current/meta/gui/icon.png
StartupWMClass=draw.io
MimeType=application/vnd.jgraph.mxfile;application/vnd.visio;
Categories=Graphics;
